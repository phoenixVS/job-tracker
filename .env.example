# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./jobs.db

# --- Job sources -----------------------------------------------------------
# Leave a key empty to disable that source. With BOTH keys empty the app uses
# bundled mock postings so the whole pipeline works offline.
JOBDATALAKE_API_KEY=
JOBDATALAKE_BASE_URL=https://api.jobdatalake.com/v1
WORKLITTLE_API_KEY=
WORKLITTLE_BASE_URL=https://api.worklittle.com

# --- Matching --------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.45
DAILY_TARGET_COUNT=15

# --- Fetching --------------------------------------------------------------
REMOTE_ONLY=true
# Pass the CV's estimated seniority to the job APIs as a hard filter.
FILTER_BY_SENIORITY=false
FETCH_LOOKBACK_DAYS=2
MAX_JOBS_PER_SOURCE=1500
# Stage 2: fetch full descriptions for this many best stage-1 candidates.
# Only jobs with a fetched description can appear in the daily list.
DETAIL_ENRICH_TOP_N=200
HTTP_MAX_RETRIES=4
HTTP_TIMEOUT_SECONDS=30

# Worklittle is slow (search ~30s, detail ~90s) and its free tier allows 1,000 jobs/month,
# so it has its own limits. 300 jobs per sync uses the free quota up in about 3 syncs;
# 30 per daily sync stays within it.
WORKLITTLE_MAX_JOBS=300
WORKLITTLE_DETAIL_TOP_N=5
WORKLITTLE_TIMEOUT_SECONDS=120
WORKLITTLE_MAX_RETRIES=1

# --- Scheduling ------------------------------------------------------------
SCHEDULER_ENABLED=true
SYNC_INTERVAL_HOURS=24
SYNC_ON_STARTUP=false

LOG_LEVEL=INFO
